<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.devpilot</groupId>
    <artifactId>devpilot-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>devpilot</name>
    <description>AI Software Factory: BUG-to-change automation platform</description>

    <modules>
        <module>devpilot-common</module>
        <module>devpilot-project</module>
        <module>devpilot-bug</module>
        <module>devpilot-ai</module>
        <module>devpilot-task</module>
        <module>devpilot-executor</module>
        <module>devpilot-repository</module>
        <module>devpilot-verification</module>
        <module>devpilot-gateway</module>
        <module>devpilot-center</module>
    </modules>

    <properties>
        <java.version>17</java.version>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <flyway.version>11.7.2</flyway.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.devpilot</groupId>
                <artifactId>devpilot-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.devpilot</groupId>
                <artifactId>devpilot-project</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.devpilot</groupId>
                <artifactId>devpilot-bug</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.devpilot</groupId>
                <artifactId>devpilot-ai</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.devpilot</groupId>
                <artifactId>devpilot-task</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.devpilot</groupId>
                <artifactId>devpilot-executor</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.devpilot</groupId>
                <artifactId>devpilot-repository</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.devpilot</groupId>
                <artifactId>devpilot-verification</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.devpilot</groupId>
                <artifactId>devpilot-gateway</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <configuration>
                        <argLine>-Dfile.encoding=UTF-8</argLine>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
